{
  "name": "@ansonli.dev/rigup",
  "version": "0.3.1",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^22.19.0 || >=24.2.0"
  },
  "bin": {
    "rigup": "dist/cli.js"
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts test/harness-e2e/*.test.mjs",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:live": "node test/run-live-tests.mjs",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm test && npm run build && npm run check:docs && npm run test:package",
    "check:docs": "node scripts/check-docs.mjs",
    "test:package": "node scripts/check-package.mjs",
    "release:build": "node scripts/release/build.mjs",
    "release:check": "node scripts/release/check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "ignore": "7.0.14",
    "jsonc-parser": "3.3.1",
    "node-diff3": "3.2.1",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "description": "Prepare project-specific coding-agent workflows and install them with protected updates",
  "files": [
    "dist",
    "templates",
    "docs/guides",
    "docs/compatibility/status.md",
    "docs/compatibility/validation-0.3.0.md",
    "docs/compatibility/upstream-lock.json",
    "README.md",
    "README.zh-CN.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ansonli-dev/rigup#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ansonli-dev/rigup.git"
  },
  "bugs": {
    "url": "https://github.com/ansonli-dev/rigup/issues"
  },
  "keywords": [
    "coding-agent",
    "codex",
    "mcp",
    "developer-tools",
    "workflow"
  ]
}
