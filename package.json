{
  "name": "rigup",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "rigup": "dist/cli.js"
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:live": "RIGUP_LIVE=1 node --import tsx --test --test-concurrency=1 test/live-*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "jsonc-parser": "3.3.1",
    "node-diff3": "3.2.1",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "description": "Prepare project-specific coding-agent workflows and install them with protected updates",
  "files": [
    "dist",
    "templates",
    "docs/compatibility/upstream-lock.json",
    "README.md"
  ]
}
